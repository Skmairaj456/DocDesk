# Select "live" to use authenticated Supabase/PostgreSQL data in local development.
DOC_DESK_MODE=simulator

# Runtime connection. Use a dedicated non-owner, non-BYPASSRLS role in production.
DATABASE_URL=
# Optional elevated migration connection. Defaults to DATABASE_URL for local development.
MIGRATION_DATABASE_URL=

# Optional database-isolation test target. Must be local and end in _test or -test.
DOC_DESK_TEST_DATABASE_URL=

# Supabase Auth project settings. The anon/publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed to provision demo accounts locally. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required by the WhatsApp Cloud API webhook. Keep all values server-only.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLINIC_ID=
# Twilio (takes precedence over Meta direct when all three are set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: +14155238886. Production: your approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=
# Exact public URL of /api/whatsapp/twilio (used to verify signatures and for delivery callbacks)
TWILIO_WEBHOOK_URL=

# Protects the scheduled-job endpoint; use a long random secret.
CRON_SECRET=

# Set to "enabled" to expose /simulator in production (demo only). Always on in development.
DOC_DESK_SIMULATOR=
# TEST DEPLOYMENTS ONLY: set to "enabled" to let the @docdesk.demo logins work in production.
DOC_DESK_ALLOW_DEMO_ACCOUNTS=
# Graph API version for real sends. Defaults to v21.0.
WHATSAPP_API_VERSION=
